#include "burger.css"
#include "fonts.css"
#include "language.css"
#include "stamp.css"
#include "airmail.css"
#include "defines.css.in"

#define H2_DEFAULTS()                        \
    font-family: 'Pinyon Script';            \
    font-size: clamp(2.2rem, 10vw, 3.3rem);  \

#define H3_DEFAULTS()                        \
    font-family: 'Pinyon Script';            \
    font-size: clamp(1.76rem, 9vw, 2.8rem);  \

/* Reset some default styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    ROOT_DEFINES();
}

h2, h3 {
    text-align: center;
}

p {
    text-align: justify;
}

.rounded-framing-light {
    border-radius: clamp(0px, 5vw, 35px);
    border: 1.5px solid var(--color-light);
    box-sizing: border-box;
}

.banner-section {
    background: var(--color-mid);
    display: flex;
    flex-direction: column;
    align-items: center;
    SECTION_PADDING();
}

/* Airmail defaults */
.airmail > * {
    position: absolute;
}

.airmail .par-avion {
    color: var(--airmail-stripe-color2);
    font-family: 'Aileron Bold';
    font-size: 1.95vw;
    transform: translateX(1vw) translateY(1vw);
}

.airmail h1 {
    transform: translateX(17.63vw) translateY(6.7vw);
    font-family: 'New Icon Serif Regular';
    font-size: 8.5vw;
}
.airmail h1 > .line2 {
    display: inline-block;
    margin-left: 13.8vw;
    font-family: 'Pinyon Script';
}

.airmail .stamp-border {
    --stamp-border-radius: 0.25vw;
    width: 15vw;
    transform: translateX(62vw) translateY(2vw);
}

.airmail svg {
    width: 13vw;
    margin-top: 3.1vw;
}

/* Desktop (low-res) */
@media (max-width: 1200px) {
    .airmail {
        --airmail-stripe-slice: 20;
    }
}

/* Mobile */
@media (max-width: 769px) {
    .airmail {
        --airmail-stripe-slice: 10;
        aspect-ratio: 1.7 / 1;
    }

    .airmail h1 {
        transform: translateX(17.63vw) translateY(10vw);
        font-size: 10.2vw;
    }
}

.banner-section > h2 {
    color: var(--color-dark);
    font-family: 'Aileron';
    font-size: 2em;
    font-weight: normal;
}

.flights-section {
    SECTION_PADDING();
    color: var(--color-dark);
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-light);
    font-family: 'Aileron';
    padding-left: 3rem;
    padding-right: 3rem;
    gap: 0.5rem;
}
.flights-section p {
    max-width: 950px;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
}
.flights-section h2 {
    H2_DEFAULTS();
}

.local-transport-section {
    SECTION_PADDING();
    color: var(--color-light);
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-dark);
    font-family: 'Aileron';
    padding-left: 3rem;
    padding-right: 3rem;
    gap: 0.5rem;
}
.local-transport-section > img {
    width: clamp(250px, 20vw, 300px);
    margin-bottom: 1.8rem;
}
.local-transport-section p {
    max-width: 950px;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
}
.local-transport-section h2 {
    H2_DEFAULTS();
}
.local-transport-section h2 em {
    font-family: 'New Icon Serif Regular';
}
.local-transport-section h3 {
    H3_DEFAULTS();
}
.local-transport-section a {
    color: var(--color-link-light);
}
