#include "burger.css"
#include "fonts.css"
#include "language.css"
#include "defines.css.in"

/* Reset some default styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    ROOT_DEFINES();
}

.banner-section {
    margin-top: 6em;
    margin-bottom: 6em;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.banner-section h1 {
    font-family: 'New Icon Serif Regular';
    font-size: 13.1vw;
    color: var(--color-dark);
}

