#include "burger.css"
#include "fonts.css"
#include "language.css"
#include "defines.css.in"

/* Reset some default styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    ROOT_DEFINES();
}

.banner-section {
    margin-top: 4.3em;
    margin-bottom: 4.3em;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.3em;
}

.banner-section h1 {
    font-family: 'New Icon Serif Regular';
    font-size: clamp(2.5rem, 13.1vw, 8rem);
    font-weight: normal;
    color: var(--color-dark);
}

img[src='rose-light.webp'] {
    width: clamp(40px, 17vw, 100px);
}

.polaroid {
    --width: clamp(200px, 35vw, 380px);
    --top-ratio: 0.046;
    --bot-ratio: 0.191;
    width: var(--width);

    /* Polaroid look like in index.html */
    background: white;
    padding:
        calc(var(--top-ratio) * var(--width))
        calc(var(--top-ratio) * var(--width))
        calc(var(--bot-ratio) * var(--width))
        calc(var(--top-ratio) * var(--width));
    border: 1px solid rgba(0,0,0,0.15);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
    transform: rotate(-2deg);
    display: block;
}

.polaroid img {
    width: 100%;
    filter: sepia(1);
}

.info-section {
    SECTION_PADDING();
    background: var(--color-dark);
    color: var(--color-light);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-left: 3rem;
    padding-right: 3rem;
    font-family: 'Aileron';
    gap: 2.45em;
}

.info-title {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 2em;
}
.info-title img {
    height: calc(1.86 * clamp(2.2rem, 10vw, 3.3rem));
    width: auto;
}
.mirror {
    transform: scale(-1, 1);
}

.info-section h2 {
    color: var(--color-mid);
    font-family: 'Pinyon Script';
    font-size: clamp(2.2rem, 10vw, 3.3rem);
}
.info-section a {
    color: var(--color-link-light);
}
.info-section .essay {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
}
.info-section ul {
    margin-left: 2em;
}

.discount-code {
    font-weight: bolder;
}