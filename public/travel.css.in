#include "burger.css"
#include "fonts.css"
#include "language.css"
#include "stamp.css"
#include "airmail.css"
#include "defines.css.in"
#include "octagon.css.in"

#define H2_DEFAULTS()                        \
    font-family: 'Pinyon Script';            \
    font-size: clamp(2.2rem, 10vw, 3.3rem);  \

#define H3_DEFAULTS()                        \
    font-family: 'Pinyon Script';            \
    font-size: clamp(1.76rem, 9vw, 2.8rem);  \

/* Reset some default styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    ROOT_DEFINES();
}

h2, h3 {
    text-align: center;
}

p {
    text-align: justify;
}

.rounded-framing-light {
    border-radius: clamp(0px, 5vw, 35px);
    border: 1.5px solid var(--color-light);
    box-sizing: border-box;
}

.banner-section {
    background: var(--color-mid);
    display: flex;
    flex-direction: column;
    align-items: center;
    SECTION_PADDING();
}
.banner-section h2 strong {
    font-family: 'New Icon Serif Regular';
    font-weight: bolder;
    font-style: italic;
    font-size: 1.5em;
}

/* Airmail defaults */
.airmail > * {
    position: absolute;
}

.airmail .par-avion {
    color: var(--airmail-stripe-color2);
    font-family: 'Aileron Bold';
    font-size: 1.95vw;
    transform: translateX(1vw) translateY(1vw);
}

.airmail h1 {
    transform: translateX(17.63vw) translateY(6.7vw);
    font-family: 'New Icon Serif Regular';
    font-size: 8.5vw;
    color: var(--color-dark);
}
.airmail h1 > .line2 {
    display: inline-block;
    margin-left: 13.8vw;
    font-family: 'Pinyon Script';
}

.airmail .stamp-border {
    --stamp-border-radius: 0.25vw;
    width: 15vw;
    transform: translateX(62vw) translateY(2vw);
}

.airmail svg {
    width: 13vw;
    margin-top: 3.1vw;
}

/* Desktop (low-res) */
@media (max-width: 1200px) {
    .airmail {
        --airmail-stripe-slice: 20;
    }
}

/* Mobile */
@media (max-width: 769px) {
    .airmail {
        --airmail-stripe-slice: 10;
        aspect-ratio: 1.7 / 1;
    }

    .airmail h1 {
        transform: translateX(17.63vw) translateY(10vw);
        font-size: 10.2vw;
    }
}

.banner-section > h2 {
    color: var(--color-dark);
    font-family: 'Aileron';
    font-size: 2em;
    font-weight: normal;
}

.flights-section {
    SECTION_PADDING();
    color: var(--color-dark);
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    background: var(--color-light);
    font-family: 'Aileron';
    padding-left: 3rem;
    padding-right: 3rem;
    gap: 1.5rem;
}
.flights-section > img {
    width: clamp(100px, 20vw, 200px);
}
.flights-section p {
    max-width: 700px;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
}
.flights-section h2 {
    H2_DEFAULTS();
    text-align: center;
}

.local-transport-section {
    SECTION_PADDING();
    color: var(--color-light);
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-dark);
    font-family: 'Aileron';
    padding-left: 3rem;
    padding-right: 3rem;
    gap: 0.5rem;
}
.local-transport-section > img {
    width: clamp(250px, 20vw, 300px);
    margin-bottom: 1.8rem;
}
.local-transport-section p {
    max-width: 950px;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
}
.local-transport-section h2 {
    H2_DEFAULTS();
}
.local-transport-section h2 em {
    font-family: 'New Icon Serif Regular';
}
.local-transport-section h3 {
    H3_DEFAULTS();
}
.local-transport-section a {
    color: var(--color-link-light);
}

.pilares-section {
    SECTION_PADDING();
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    font-family: 'Aileron';
    padding-left: 3rem;
    padding-right: 3rem;
    gap: 3rem;
    background: var(--color-light);
    color: var(--color-dark);
}
.pilares-section h2 {
    font-family: 'New Icon Serif Regular';
    font-size: clamp(1.78rem, 8.2vw, 2.5rem);
    font-weight: bold;
}
.pilares-section .essay {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 500px;
}
.pilares-section p {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
}
.pilares-section .essay img {
    width: 150px;
    padding-top: 1.8rem;
}

.thingstodo-section {
    SECTION_PADDING();
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: 'Aileron';
    padding-left: 3rem;
    padding-right: 3rem;
    gap: 3rem;
    color: var(--color-dark);
}
.thingstodo-section h2 {
    font-family: 'New Icon Serif Regular';
    font-size: clamp(1.78rem, 8.2vw, 2.5rem);
    font-weight: bold;
}
.thingstodo-section .section-row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 0;
    align-items: center;
    gap: 3rem;
}
.thingstodo-section .section-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
}
.thingstodo-section .section-column img[src='./flowers1-dark.webp'] {
    transform: scale(1, -1) rotate(90deg);
    width: 150px;
}
.thingstodo-section .section-row ol {
    max-width: 500px;
}
.thingstodo-section li {
    font-weight: bolder;
    font-size: 1.2em;
}
.thing-desc span {
    font-weight: normal;
    font-size: 0.8em;
}
.thingstodo-section li + li {
    margin-top: 1.5em;
}
octagon-wrapper-white::before {
    background: white;
}
