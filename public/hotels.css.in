#include "burger.css"
#include "fonts.css"
#include "language.css"
#include "defines.css.in"

/* Reset some default styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    ROOT_DEFINES();
}

.banner-section {
    margin-top: 4.3em;
    margin-bottom: 4.3em;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.3em;
}

.banner-section h1 {
    font-family: 'New Icon Serif Regular';
    font-size: clamp(2.5rem, 13.1vw, 8rem);
    color: var(--color-dark);
}

.hero-section {
    background: var(--color-dark);
    padding: 3.1em;
    display: flex;
    flex-direction: column;
    align-items: center;
}

img[src='rose-light.webp'] {
    width: clamp(40px, 17vw, 100px);
}

img[src='hotels-hero.jpeg'] {
    --width: clamp(0px, 60vw, 440px);
    --top-ratio: 0.046;
    --bot-ratio: 0.191;
    width: var(--width);

    /* Polaroid look like in index.html */
    background: white;
    padding:
        calc(var(--top-ratio) * var(--width))
        calc(var(--top-ratio) * var(--width))
        calc(var(--bot-ratio) * var(--width))
        calc(var(--top-ratio) * var(--width));
    border: 1px solid rgba(0,0,0,0.15);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
    transform: rotate(-2deg);
    filter: sepia(1);
    display: block;
}

