#include "burger.css"
#include "fonts.css"
#include "language.css"
#include "stamp.css"
#include "defines.css.in"
#include "octagon.css.in"

#define SECTION_DEFAULTS()                   \
    display: flex;                           \
    align-items: center;                     \
    justify-content: center;                 \
    text-align: center;                      \
    SECTION_PADDING();                       \

#define MODEST_NEW_ICON_SERIF_REGULAR()      \
    font-family: 'New Icon Serif Regular';   \
    font-size: clamp(2rem, 11vw, 5rem);      \

#define MODEST_PINYON_SCRIPT()               \
    font-family: 'Pinyon Script';            \
    font-size: clamp(2rem, 11vw, 5rem);      \

:root {
    ROOT_DEFINES();
}

body {
    margin: 0;
}

.banner-section {
    SECTION_DEFAULTS();
    background: var(--color-mid);
    color: var(--color-dark);
}

.section-row {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    white-space: nowrap;
    max-width: 100vw;
}

.banner-name,
.banner-conjunction {
    display: inline-block;
    vertical-align: middle;
}

.banner-name {
    font-family: 'New Icon Serif Regular';
    font-size: clamp(2.5rem, 18vw, 10rem);
    padding-top: 0.22em;
}

.banner-conjunction {
    font-family: 'Pinyon Script';
    font-size: clamp(2rem, 12vw, 6rem);
    padding-left: 0.31em;
}

.banner-conjunction[lang="en"] {
    padding-right: 0.62em;
}

.banner-conjunction[lang="es"] {
    padding-right: 0.31em;
}

.banner-conjunction[lang="fr"] {
    padding-right: 0.50em;
}

.banner-image-triplet {
    position: relative;
    width: clamp(400px, 75vw, 900px);
    aspect-ratio: 3 / 1;
    margin: 0 auto;
    --flower-scale: 0.7;
}

.banner-image-triplet > * {
    position: absolute;
    width: auto;
    object-fit: contain;
}

.banner-image-triplet > *:nth-child(1) {
    left: 0;
    transform: scale(1, -1) rotate(90deg);
}

.banner-image-triplet > *:nth-child(2) {
    height: 100%;
    aspect-ratio: 5 / 4;
    left: 50%;
    transform: translateX(-50%);
}

.banner-image-triplet > *:nth-child(3) {
    right: 0;
    transform: rotate(-90deg);
}

/* scale the flowers on the side of picture of Mary & Oli by --flower-scale */
.banner-image-triplet > *:nth-child(1),
.banner-image-triplet > *:nth-child(3) {
    height: calc(var(--flower-scale) * 100%);
    top: calc((1 - var(--flower-scale)) * 50%);
}

.banner-date {
    font-family: 'Aileron Bold';
    font-size: clamp(1rem, 2vw, 1.5rem);
}

.banner-location {
    font-family: 'Aileron';
    font-size: clamp(1rem, 2vw, 1.5rem);
}

.photo-section {
    height: clamp(300px, 60vh, 800px);
    overflow: hidden;
}

.photo-section img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
}

.where-section {
    SECTION_DEFAULTS();
    background: var(--color-light);
    color: var(--color-dark);
}

.where-row-title {
    MODEST_PINYON_SCRIPT();
    font-weight: normal;
    justify-content: left;
}

.where-row-p {
    MODEST_NEW_ICON_SERIF_REGULAR();
}

.where-stamp-container {
    width: clamp(325px, 45vw, 730px);
    margin-top: 1em;
    margin-bottom: 1em;
}

.where-stamp-container > img {
    filter: sepia(1);
}

.rounded-framing {
    border-radius: clamp(0px, 5vw, 35px);
    border: 1.5px solid var(--color-dark);
    box-sizing: border-box;
}

.bigday-section {
    SECTION_DEFAULTS();
    flex-direction: row;
    gap: 3rem;
}

.bigday-middle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 2rem;
    width: 20vw;
    color: var(--color-dark);
    MODEST_NEW_ICON_SERIF_REGULAR();
}
.bigday-middle img { /* image of flower2*/
    width: 50%;
}
.bigday-middle em {
    MODEST_PINYON_SCRIPT();
}

.bigday-section > img { /* photos of mary&oli*/
    width: clamp(100px, 17.2vw, 250px);
    display: block;
}

.schedule-section {
    SECTION_DEFAULTS();
    flex-wrap: wrap;
    gap: 3rem;
    background: var(--color-dark);
    color: var(--color-mid);
}

.schedule-section .polaroid {
    max-width: 55vw;
    max-height: 450px;

    /* Polaroid frame */
    background: white;
    padding: 12px 12px 40px 12px; /* bottom padding bigger = classic Polaroid look */

    border: 1px solid rgba(0,0,0,0.15);

    /* shadow for "floating photo" effect */
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);

    /* slight tilt makes it feel more real */
    transform: rotate(-2deg);

    /* important so padding behaves nicely */
    display: block;

}

.schedule-title .wedding {
    font-family: 'Pinyon Script';
    font-size: 3.3rem;
    font-weight: normal;
    justify-content: left;
}

.schedule-title .program {
    font-family: 'New Icon Serif Regular';
    font-size: 2rem;
    font-weight: normal;
    justify-content: left;
}

.schedule-section img[src='flowers1-light.webp'] {
    max-height: 155px;
}

.schedule-title {
    display: flex;
    align-items: center;
    gap: 25px;
    text-align: left;
    margin-left: 2rem;
    margin-bottom: 3rem;
}

.schedule {
    list-style: none;
    padding: 0;
    font-family: 'Aileron';
}

.schedule strong {
    font-family: 'Aileron Bold';
}

.schedule li {
    display: grid;
    grid-template-columns: 100px 1fr;
    margin: 1em;
}

.schedule time {
    grid-column: 1;
}

.schedule div[lang] {
    grid-column: 2;
    margin: 0;
    text-align: left;
}
.schedule p {
    margin: 0;
}

.faq-section {
    SECTION_DEFAULTS();
    flex-direction: column;
    gap: 2rem;
    background: var(--color-light);
    color: var(--color-dark);
}
.faq-section .section-column {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 1.15em;
}
.faq-section .section-row {
    display: flex;
    flex-direction: row;
}
.faq-section img[src='./flowers1-dark.webp'] {
    transform: rotate(-90deg);
    max-height: 155px;
}
.faq-title {
    display: flex;
    flex-direction: column;
    font-family: 'New Icon Serif Regular';
    font-size: 2rem;
    font-weight: normal;
}
.faq-title em {
    font-family: 'Pinyon Script';
    font-size: 3.3rem;
    font-weight: normal;
}
.faq-title > *:nth-child(2) {
    padding-left: 2em;
}
.faq-section p {
    margin: 0;
    font-size: 0.92em;
    max-width: min(90vw, 550px);
    text-align: justify;
}
.faq-section ul {
    margin: 0;
    text-align: left;
}
.faq-section .tab-panel {
    border: 1px solid var(--color-dark);
    padding: 1rem;
}
.faq-section .tab-panel > div:first-child {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
}
.faq-section .tab-panel button[data-tab] {
    background: var(--color-light);
    color: var(--color-dark);
    border: 1px solid var(--color-dark);
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    font: inherit;
    text-align: left;
}
.faq-section .tab-panel button[data-tab][data-active="true"] {
    background: var(--color-dark);
    color: var(--color-light);
}
.faq-section .tab-panel button[data-tab]:hover {
    opacity: 0.85;
}
.faq-section .tab-panel .tab-content {
    text-align: left;
}

.rsvp-section {
    SECTION_DEFAULTS();
    flex-direction: column;
    gap: 2rem;
    background: var(--color-mid);
    color: var(--color-light);
}

.rsvp-section .section-row {
    display: flex;
    flex-direction: row;
}

.rsvp-button-triplet {
    --max-padding: 5rem;
    display: flex;
    align-items: center;
    gap: clamp(0px, 5vw, var(--max-padding));
}

.rsvp-button-triplet img {
    height: clamp(60px, 30vw, 200px);
}

.rsvp-button-triplet img:nth-child(1) {
    transform: scale(-1, 1);
}

.rsvp-section .octagon-wrapper {
    width: clamp(180px, 20vw, 325px) ;
}

.capsule {
    display: inline-block;
    font-family: 'New Icon Serif Regular';
    font-size: 2rem;
    background: var(--color-light);
    border-radius: 9999px;
    border: 2px solid var(--color-mid);
    box-shadow: 0 4px 3px var(--color-dark);
    color: var(--color-dark);
    font-weight: 600;
    line-height: 1;
    padding: 0.6em 1.2em;
    text-decoration: none;
}
